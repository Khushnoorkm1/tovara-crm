# =====================================================================
#  Restaurant CRM — Environment Variables
#  Copy to `.env.local` and fill in real values.
# =====================================================================

# Database (PostgreSQL)
# Local dev:    postgresql://postgres:postgres@localhost:5432/restaurant_crm
# Neon/Supabase: paste their connection string
DATABASE_URL="postgresql://neondb_owner:npg_ZsdaYOFpPD09@ep-dark-wave-aofywt6a.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Auth.js — generate a secret with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"
AUTH_URL="http://localhost:3000"

# Google OAuth (optional in dev — leave blank to disable Google login)
# Get from https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# App URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_DOMAIN="localhost:3000"

# ===== Messaging providers (Phase 6) =====
# Leave these blank in development — emails and SMS will log to the dev
# console instead of being sent. Fill them in to send for real.

# Email (Resend) — get a key at https://resend.com
RESEND_API_KEY=""
MAIL_FROM_EMAIL="reservations@example.com"
MAIL_FROM_NAME="Mario's Bistro"

# SMS (Twilio) — get creds at https://console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_PHONE=""

# ===== Phase 7+ providers (placeholders for now) =====

# Payments (Stripe) — used in Phase 8
# These are NOT required as env vars — each tenant configures their own
# Stripe credentials in Settings → Integrations and we charge against the
# *restaurant's* Stripe account, not a platform-level one. Stripe is reached
# directly via REST API (no SDK dep). Webhook receiver lives at
# {NEXT_PUBLIC_APP_URL}/api/webhooks/stripe.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Background jobs (Inngest) — used in Phase 9 polish
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
